# Copy to .env and fill in real values. Never commit .env to git.
# Get AI_BUILDER_TOKEN from AI Builders platform / MCP settings.

AI_BUILDER_TOKEN=sk_your_token_here

# Optional: when running Streamlit frontend against deployed backend
# BACKEND_URL=https://tool-box-chen.ai-builders.space

# Optional: override AI Builders API base URL (default: https://space.ai-builders.com/backend)
# AI_BUILDERS_BASE_URL=https://space.ai-builders.com/backend

# Optional: use GPU for EasyOCR on the backend server (CUDA + torch with CUDA required)
# INSPECTION_REPORT_OCR_GPU=1

# Azure Document Intelligence (highest-accuracy OCR; used first when configured)
# Get keys from Azure Portal → your Document Intelligence resource → Keys and Endpoint
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=your_key_here

# OCR engine: auto (default: Azure DI → surya → easyocr → tesseract), azure, surya, easyocr, tesseract
# INSPECTION_REPORT_STRUCTURED_OCR_ENGINE=auto
